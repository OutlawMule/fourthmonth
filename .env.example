# Copy this file to `.env.local` (never commit it) and fill in the two values.
# Both are PUBLIC client values - protected by Row Level Security in the database.
# NEVER put the Supabase service-role key (or any other secret) in a VITE_ variable.
# (npm run dev and npm run build stop with a message if they find one, so it cannot be published by accident.)

# Supabase dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase dashboard -> Project Settings -> API Keys -> "Publishable key" (sb_publishable_...)
# Older projects can use the legacy "anon public" JWT key here instead - the client accepts either.
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY
